          -- Implement a PL/SQL block with a cursor to fetch and display the Name and Salary of the
          -- top 5 highest-paid employees from the Staff table.
          
          CREATE TABLE Staff (
              Staff_ID NUMBER PRIMARY KEY,
              Name VARCHAR2(50),
              Salary NUMBER(10,2)
          );
          
          INSERT INTO Staff VALUES (1, 'Rahul', 45000);
          INSERT INTO Staff VALUES (2, 'Amit', 75000);
          INSERT INTO Staff VALUES (3, 'Priya', 65000);
          INSERT INTO Staff VALUES (4, 'Neha', 90000);
          INSERT INTO Staff VALUES (5, 'Ravi', 55000);
          INSERT INTO Staff VALUES (6, 'Simran', 85000);
          INSERT INTO Staff VALUES (7, 'Karan', 60000);
          INSERT INTO Staff VALUES (8, 'Anjali', 95000);
          INSERT INTO Staff VALUES (9, 'Vikas', 70000);
          INSERT INTO Staff VALUES (10, 'Pooja', 50000);
          
          select * from staff;
          
          DECLARE
              CURSOR emp_cursor IS
                  SELECT Name, Salary
                  FROM Staff
                  ORDER BY Salary DESC;
          
              v_name   Staff.Name%TYPE;
              v_salary Staff.Salary%TYPE;
              v_count  NUMBER := 0;
          
          BEGIN
              OPEN emp_cursor;
          
              LOOP
                  FETCH emp_cursor INTO v_name, v_salary;
                  EXIT WHEN emp_cursor%NOTFOUND OR v_count = 5;
                  v_count := v_count + 1;
                  DBMS_OUTPUT.PUT_LINE(
                      'Name: ' || v_name || ' | Salary: ' || v_salary
                  );
              END LOOP;
              CLOSE emp_cursor;
          END;
          /
