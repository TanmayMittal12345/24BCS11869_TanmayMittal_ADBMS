          -- Write a PL/SQL cursor loop to process the Orders table row-by-row and print "High Value" for every order where the Amount exceeds 10,000.  
          CREATE TABLE Orders (
              Order_ID NUMBER PRIMARY KEY,
              Customer_Name VARCHAR2(50),
              Amount NUMBER(10,2)
          );
          
          INSERT INTO Orders VALUES (101, 'Rahul', 15000);
          INSERT INTO Orders VALUES (102, 'Amit', 8000);
          INSERT INTO Orders VALUES (103, 'Priya', 25000);
          INSERT INTO Orders VALUES (104, 'Neha', 5000);
          INSERT INTO Orders VALUES (105, 'Ravi', 12000);
          INSERT INTO Orders VALUES (106, 'Simran', 9500);
          
          SET SERVEROUTPUT ON;
          
          DECLARE
              CURSOR order_cursor IS
                  SELECT Order_ID, Customer_Name, Amount
                  FROM Orders;
          
          BEGIN
              FOR order_record IN order_cursor
              LOOP
                  IF order_record.Amount > 10000 THEN
                      DBMS_OUTPUT.PUT_LINE(
                          'Order ID: ' || order_record.Order_ID ||
                          ' | Customer: ' || order_record.Customer_Name ||
                          ' | Amount: ' || order_record.Amount ||
                          ' | High Value'
                      );
                  END IF;
              END LOOP;
          END;
          /
